generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  OWNER
  ADMIN
  ADMIN_PROYEK
  LPJ_VIEWER
  MANDOR
  PELAKSANA
  ADM_FOTO
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
}

enum BillingMode {
  ON_REQUEST
  TERMIN_PLAN
  PAY_AT_END
}

enum CashSourceType {
  BANK
  CASH
  CLIENT_TRANSFER
  OTHER
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  name         String
  passwordHash String
  role         Role          @default(MANDOR)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  cashTransfers CashTransfer[]
  projectAssignments ProjectAssignment[]
  mandorDisbursements MandorDisbursement[] @relation("MandorDisbursements")
  mandorExpenseLines MandorExpenseLine[]
  sitePhotos ProjectSitePhoto[]
  taxObligationsPaid TaxWithholdingLine[] @relation("TaxObligationPaidBy")
}

model Project {
  id             String         @id @default(cuid())
  name           String
  location       String
  status         ProjectStatus  @default(ACTIVE)
  billingMode    BillingMode    @default(ON_REQUEST)
  openingBalance Int            @default(0)
  contractValue  Int            @default(0)
  /// Kas terpisah permanen dari kas besar Owner. Hanya untuk proyek baru.
  standaloneBookkeeping Boolean @default(false)
  notes          String?        @db.Text
  checkPlanning    Boolean      @default(false)
  checkSupervision Boolean      @default(false)
  checkManagement  Boolean      @default(false)
  checkTax         Boolean      @default(false)
  checkReporting   Boolean      @default(false)
  checkContractor  Boolean      @default(false)
  checkNoRetention Boolean      @default(false)
  /// Pejabat tanda tangan LPJ / Buku Bank
  lpjKepalaNama     String?
  lpjKepalaNip      String?
  lpjKetuaNama      String?
  lpjKetuaNip       String?
  lpjBendaharaNama  String?
  lpjBendaharaNip   String?
  lpjKabKota        String?
  lpjProvinsi       String?
  /// NPWP sekolah / bendahara untuk rekap pajak
  lpjNpwp           String?
  lpjKepalaTtdUrl   String? @db.Text
  lpjKetuaTtdUrl    String? @db.Text
  lpjBendaharaTtdUrl String? @db.Text
  lpjStempelUrl     String? @db.Text
  /// Folder Google Drive per proyek (dibuat sekali, di-reuse)
  driveProjectFolderId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  transactions   Transaction[]
  fundingStages  FundingStage[]
  workItems      WorkItem[]
  contractor     Contractor?
  funds          ProjectFund[]
  assignments    ProjectAssignment[]
  mandorDisbursements MandorDisbursement[]
  spkBudgetLines      SpkBudgetLine[]
  bankTranches        BankTranche[]
  workers             Worker[]
  payrollHokLines     PayrollHokLine[]
  taxWithholdingLines TaxWithholdingLine[]
  taxMonthNotes       TaxMonthNote[]
  lpjSnapshots        LpjSnapshot[]
  sitePhotos          ProjectSitePhoto[]
}

model ProjectAssignment {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

/// Foto lokasi proyek (Mandor / ADM Foto) — arsip VPS
model ProjectSitePhoto {
  id               String   @id @default(cuid())
  takenAt          DateTime @default(now())
  caption          String?  @db.Text
  photoUrl         String   @db.Text
  /// Nama file asli (unik per proyek) — cegah unggah dobel
  sourceName       String   @db.VarChar(255)
  driveFileId      String?
  driveWebViewLink String?  @db.Text
  driveSyncError   String?  @db.Text
  latitude         Float?
  longitude        Float?
  createdAt        DateTime @default(now())

  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User    @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([projectId, sourceName])
  @@index([projectId, takenAt])
  @@index([createdById])
}

/// Dana Owner → Mandor (bukan termin klien)
model MandorDisbursement {
  id          String   @id @default(cuid())
  date        DateTime
  label       String
  sequence    Int      @default(1)
  amount      Int
  description String   @default("")
  proofUrl    String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mandorId     String
  mandor       User       @relation("MandorDisbursements", fields: [mandorId], references: [id], onDelete: Restrict)
  cashSourceId String
  cashSource   CashSource @relation(fields: [cashSourceId], references: [id], onDelete: Restrict)
  transactionId String?   @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  linkedProofs Transaction[] @relation("ProofLinkedToDisbursement")

  @@index([projectId])
  @@index([mandorId])
  @@index([date])
}

enum ProjectFundKind {
  PLANNING
  SUPERVISION
  MANAGEMENT
  TAX
  REPORTING
  SAVE
}

model ProjectFund {
  id            String          @id @default(cuid())
  kind          ProjectFundKind
  plannedAmount Int             @default(0)
  notes         String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, kind])
  @@index([projectId])
}

model Contractor {
  id           String   @id @default(cuid())
  name         String
  phone        String?
  notes        String?  @db.Text
  agreedAmount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  advances ContractorAdvance[]
  expenses ContractorExpense[]
}

enum ContractorExpenseKind {
  MATERIAL
  WAGES
  OTHER
}

model ContractorAdvance {
  id                String   @id @default(cuid())
  date              DateTime
  amount            Int
  fromProjectAmount Int      @default(0)
  fromGlobalAmount  Int      @default(0)
  description       String   @db.Text
  proofUrl          String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  cashSourceId String
  cashSource   CashSource @relation(fields: [cashSourceId], references: [id], onDelete: Restrict)
  linkedProofs Transaction[] @relation("ProofLinkedToAdvance")

  @@index([contractorId])
  @@index([date])
}

enum MandorExpenseLineKind {
  MATERIAL
  LABOR
}

enum MandorBreakdownStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Pecahan Admin atas nota Mandor (bahan / upah pekerja)
model MandorExpenseLine {
  id          String               @id @default(cuid())
  kind        MandorExpenseLineKind
  description String               @db.Text
  /// Khusus LABOR: "Tukang" | "Pembantu tukang"
  laborRole   String?
  quantity    Float?
  unit        String?
  unitPrice   Int?
  workDays    Float?
  dailyRate   Int?
  amount      Int
  isMaterialAlam Boolean           @default(false)
  taxPpn      Int                  @default(0)
  taxPph      Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdById   String
  createdBy     User        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  materialMasterId String?
  materialMaster   MaterialMaster? @relation(fields: [materialMasterId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([createdById])
  @@index([materialMasterId])
}

model ContractorExpense {
  id          String                @id @default(cuid())
  date        DateTime
  amount      Int
  kind        ContractorExpenseKind @default(OTHER)
  description String                @db.Text
  proofUrl    String?               @db.Text
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([contractorId])
  @@index([date])
}

model WorkItem {
  id          String   @id @default(cuid())
  date        DateTime
  description String   @db.Text
  quantity    Float?
  unit        String?
  amount      Int
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([date])
}

model FundingStage {
  id            String        @id @default(cuid())
  name          String
  sequence      Int           @default(1)
  percent       Int           @default(0)
  plannedAmount Int           @default(0)
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([projectId])
}

model CashSource {
  id            String         @id @default(cuid())
  name          String
  type          CashSourceType @default(OTHER)
  accountNumber String?
  notes         String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  transactions Transaction[]
  contractorAdvances ContractorAdvance[]
  transfersFrom CashTransfer[] @relation("TransferFrom")
  transfersTo   CashTransfer[] @relation("TransferTo")
  mandorDisbursements MandorDisbursement[]
}

model CashTransfer {
  id          String   @id @default(cuid())
  date        DateTime
  amount      Int
  description String   @db.Text
  proofUrl    String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fromCashSourceId String
  fromCashSource   CashSource @relation("TransferFrom", fields: [fromCashSourceId], references: [id], onDelete: Restrict)
  toCashSourceId   String
  toCashSource     CashSource @relation("TransferTo", fields: [toCashSourceId], references: [id], onDelete: Restrict)
  createdById      String
  createdBy        User       @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([date])
  @@index([fromCashSourceId])
  @@index([toCashSourceId])
}

model Category {
  id           String         @id @default(cuid())
  name         String
  type         CategoryType
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  transactions Transaction[]

  @@unique([name, type])
}

model Transaction {
  id          String          @id @default(cuid())
  date        DateTime
  type        TransactionType
  amount      Int
  description String          @db.Text
  proofUrl    String?         @db.Text
  isOwnerPersonal Boolean     @default(false)
  isFromGlobalCash Boolean    @default(false)
  isFeeTransfer   Boolean     @default(false)
  isMandorDisbursement Boolean @default(false)
  isMandorExpense      Boolean @default(false)
  /// Pengeluaran pembayaran pajak (dari kewajiban terhutang → lunas).
  isTaxPayment         Boolean @default(false)
  /// Nota dibuat Admin untuk LPJ (nilai penuh di BKU/BKT); di Owner tampil Rp 0.
  isAdminLpjNota       Boolean @default(false)
  isMaterialAlam       Boolean @default(false)
  taxExemptReason      String?
  spkCategory          SpkCategory?
  breakdownVendor      String?
  breakdownStatus      MandorBreakdownStatus @default(PENDING)
  breakdownNote        String? @db.Text
  /// Periode gaji pecah LABOR (tanggal awal–akhir).
  laborPeriodStart     DateTime?
  laborPeriodEnd       DateTime?
  /// Nomor minggu pembayaran pekerja di proyek (1, 2, …).
  laborWeekIndex       Int?
  /// Upload Mandor yang sudah di-split menjadi beberapa BKK (shell LPJ).
  isSplitParent        Boolean @default(false)
  /// BKK hasil split — menunjuk ke upload Mandor (parent).
  splitParentId        String?
  splitParent          Transaction?  @relation("MandorNotaSplit", fields: [splitParentId], references: [id], onDelete: Cascade)
  splitChildren        Transaction[] @relation("MandorNotaSplit")
  /// Urutan BKK dalam satu upload (1..3).
  splitIndex           Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  cashSourceId   String
  cashSource     CashSource    @relation(fields: [cashSourceId], references: [id], onDelete: Restrict)
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdById    String
  createdBy      User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  fundingStageId String?
  fundingStage   FundingStage? @relation(fields: [fundingStageId], references: [id], onDelete: SetNull)
  mandorDisbursement MandorDisbursement?

  /// Bukti Mandor ditautkan ke pencairan (salah satu wajib untuk upload baru)
  linkedMandorDisbursementId String?
  linkedMandorDisbursement   MandorDisbursement? @relation("ProofLinkedToDisbursement", fields: [linkedMandorDisbursementId], references: [id], onDelete: SetNull)
  linkedContractorAdvanceId String?
  linkedContractorAdvance   ContractorAdvance? @relation("ProofLinkedToAdvance", fields: [linkedContractorAdvanceId], references: [id], onDelete: SetNull)
  expenseLines MandorExpenseLine[]
  materialMasterId String?
  materialMaster   MaterialMaster? @relation(fields: [materialMasterId], references: [id], onDelete: SetNull)
  taxWithholdingLines TaxWithholdingLine[]
  taxPaymentFor       TaxWithholdingLine? @relation("TaxPaymentTransaction")

  @@index([date])
  @@index([projectId])
  @@index([cashSourceId])
  @@index([type])
  @@index([fundingStageId])
  @@index([isOwnerPersonal])
  @@index([isFromGlobalCash])
  @@index([isFeeTransfer])
  @@index([isMandorDisbursement])
  @@index([isMandorExpense])
  @@index([isTaxPayment])
  @@index([isAdminLpjNota])
  @@index([isMaterialAlam])
  @@index([linkedMandorDisbursementId])
  @@index([linkedContractorAdvanceId])
  @@index([materialMasterId])
  @@index([splitParentId])
  @@index([isSplitParent])
}

/// Kategori pagu SPK (Admin LPJ Swakelola)
enum SpkCategory {
  PERENCANAAN
  PENGAWASAN
  PENGELOLAAN
  REHAB_FISIK
  REHAB_MEBELAIR
  PEMBANGUNAN_BARU
  MEBELAIR_BARU
  PEMBANGUNAN_APE_LUAR
  PENGELOLAAN_LINGKUNGAN
  SANITASI
}

enum BankTranchePhase {
  PHASE_70
  PHASE_30
}

enum AttendanceSource {
  MANDOR
  ADMIN
}

enum TaxKind {
  PPN_11
  PPH_15
  PPH_FINAL_35
}

enum TaxObligationStatus {
  UNPAID
  PAID
}

/// Pecahan pagu SPK per kategori (Admin)
model SpkBudgetLine {
  id              String      @id @default(cuid())
  category        SpkCategory
  amount          Int         @default(0)
  laborPercent    Int         @default(40)
  materialPercent Int         @default(60)
  isBeliBaru      Boolean     @default(false)
  notes           String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, category])
  @@index([projectId])
}

/// Pencairan bank pusat → rekening User (70% / 30%)
model BankTranche {
  id             String           @id @default(cuid())
  phase          BankTranchePhase
  percent        Int
  plannedAmount  Int              @default(0)
  receivedAmount Int              @default(0)
  receivedAt     DateTime?
  notes          String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, phase])
  @@index([projectId])
}

/// Master material (flag material alam untuk pajak)
model MaterialMaster {
  id             String   @id @default(cuid())
  name           String
  unit           String?
  isMaterialAlam Boolean  @default(false)
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions Transaction[]
  expenseLines MandorExpenseLine[]

  @@index([isMaterialAlam])
  @@index([name])
}

/// Daftar pekerja proyek
model Worker {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("Pekerja")
  dailyWage Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attendances WorkerAttendance[]
  payrollLines PayrollHokLine[]

  @@index([projectId])
  @@index([active])
}

/// Absensi pekerja (foto & data Mandor; koreksi Admin dengan catatan)
model WorkerAttendance {
  id        String           @id @default(cuid())
  date      DateTime
  present   Boolean          @default(true)
  photoUrl  String?          @db.Text
  source    AttendanceSource @default(MANDOR)
  auditNote String?          @db.Text
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  workerId String
  worker   Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, date])
  @@index([workerId])
  @@index([date])
}

/// Rekap gaji HOK (hadir × upah harian)
model PayrollHokLine {
  id         String   @id @default(cuid())
  periodMonth String
  days       Float    @default(0)
  dailyWage  Int      @default(0)
  amount     Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workerId  String
  worker    Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([projectId, workerId, periodMonth])
  @@index([projectId])
  @@index([workerId])
  @@index([periodMonth])
}

/// Keterangan per bulan pada Rekapitulasi Pembayaran Pajak
model TaxMonthNote {
  id         String   @id @default(cuid())
  year       Int
  month      Int
  keterangan String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, year, month])
  @@index([projectId])
}

/// Kewajiban pajak dari nota (terhutang → lunas setelah bayar + bukti + ID billing)
model TaxWithholdingLine {
  id         String              @id @default(cuid())
  kind       TaxKind
  baseAmount Int
  taxAmount  Int
  label      String
  monthKey   String
  status     TaxObligationStatus @default(UNPAID)
  /// ID billing / NTPN / kode bayar pajak
  billingId  String?
  proofUrl   String?             @db.Text
  paidAt     DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Nota sumber yang memunculkan pajak
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  /// Transaksi kas pengeluaran saat pajak dibayar
  paymentTransactionId String?      @unique
  paymentTransaction   Transaction? @relation("TaxPaymentTransaction", fields: [paymentTransactionId], references: [id], onDelete: SetNull)
  paidById String?
  paidBy   User?   @relation("TaxObligationPaidBy", fields: [paidById], references: [id], onDelete: SetNull)

  @@unique([transactionId, kind])
  @@index([projectId])
  @@index([projectId, status])
  @@index([monthKey])
  @@index([kind])
  @@index([transactionId])
  @@index([status])
}

/// Snapshot hasil generate LPJ (cache)
model LpjSnapshot {
  id          String   @id @default(cuid())
  periodMonth String
  generatedAt DateTime @default(now())
  jsonPayload String   @db.LongText

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([periodMonth])
}
