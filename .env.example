# Salin file ini ke .env lalu isi nilainya:
#   cp .env.example .env

# MySQL / MariaDB
# VPS (lokal): mysql://USER:PASSWORD@127.0.0.1:3306/kas_proyek
# Shared hosting: host sering "localhost"
DATABASE_URL="mysql://kas:PASSWORD@127.0.0.1:3306/kas_proyek"

# Rahasia sesi/cookie — WAJIB diganti di produksi
# Generate: openssl rand -base64 32
AUTH_SECRET=

NODE_ENV=production

# Cookie Secure: true setelah HTTPS domain aktif.
# Set false hanya jika akses via HTTP (mis. IP mentah) sebelum SSL siap.
AUTH_COOKIE_SECURE=true

# Opsional — default Next.js: 3000
# PORT=3000

# Google Drive — foto lokasi Mandor (opsional; tanpa ini foto tetap di VPS)
# Folder root: https://drive.google.com/drive/folders/1j2jja0Xs4AaRYLFKJ1Pz99wfz0ncDdTu
# Bagikan folder itu ke email service account sebagai Editor.
GOOGLE_DRIVE_ROOT_FOLDER_ID=1j2jja0Xs4AaRYLFKJ1Pz99wfz0ncDdTu
# JSON key service account (satu baris) atau base64 dari file JSON
GOOGLE_SERVICE_ACCOUNT_JSON=
